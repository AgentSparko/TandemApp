{
 "type": "object",
 "properties": {
  "id": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "user",
    "service",
    "legacy"
   ],
   "description": "legacy: a key imported from the old sign-in, under review until confirmed"
  },
  "label": {
   "type": "string"
  },
  "owner": {
   "type": [
    "string",
    "null"
   ]
  },
  "owner_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "hint": {
   "type": "string"
  },
  "scopes": {
   "type": "array",
   "items": {
    "$ref": "common.schema.json#/$defs/scope"
   }
  },
  "backends": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "string"
   }
  },
  "models": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "string"
   }
  },
  "limits": {
   "type": "object"
  },
  "memory_user": {
   "type": [
    "string",
    "null"
   ]
  },
  "source": {
   "type": "string"
  },
  "needs_review": {
   "type": "boolean"
  },
  "state": {
   "enum": [
    "active",
    "expired",
    "revoked"
   ]
  },
  "created_at": {
   "$ref": "common.schema.json#/$defs/time"
  },
  "expires_at": {
   "anyOf": [
    {
     "$ref": "common.schema.json#/$defs/time"
    },
    {
     "type": "null"
    }
   ]
  },
  "revoked_at": {
   "anyOf": [
    {
     "$ref": "common.schema.json#/$defs/time"
    },
    {
     "type": "null"
    }
   ]
  },
  "last_used_at": {
   "anyOf": [
    {
     "$ref": "common.schema.json#/$defs/time"
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "required": [
  "id",
  "kind",
  "label",
  "owner",
  "owner_id",
  "hint",
  "scopes",
  "models",
  "limits",
  "memory_user",
  "source",
  "needs_review",
  "state",
  "created_at",
  "expires_at",
  "revoked_at",
  "last_used_at"
 ],
 "additionalProperties": false,
 "description": "one token: never its secret. `hint` is its first and last characters",
 "$id": "auth-v1/token"
}
