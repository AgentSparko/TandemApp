{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/engine-connect-key-body.schema.json",
  "title": "the body of POST /v1/fleet/engines/connect/key/new: the engine host's SSH address, port and login, the engine's install folder (absolute; else guessed), the addresses the key may come from and a name for the node",
  "type": "object",
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "user": {
      "type": "string"
    },
    "engine_dir": {
      "type": "string"
    },
    "from": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "host",
    "user"
  ],
  "additionalProperties": false
}
