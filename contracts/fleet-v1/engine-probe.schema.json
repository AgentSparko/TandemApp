{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/engine-probe.schema.json",
  "title": "POST /v1/fleet/engines/probe: whether something answers there, whether it is an engine, its pairing window (no code) and its fingerprint, the fleet node that already pins it, and the finding that says what is missing; 200 whatever the address answered",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "reachable": {
      "type": "boolean"
    },
    "engine": {
      "type": "boolean"
    },
    "pairing": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "open": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "expires_in": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tries_left": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "open",
        "state",
        "expires_in",
        "tries_left",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "node": {
      "type": [
        "string",
        "null"
      ]
    },
    "finding": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "address",
    "port",
    "reachable",
    "engine",
    "pairing",
    "fingerprint",
    "node",
    "finding"
  ],
  "additionalProperties": false
}
