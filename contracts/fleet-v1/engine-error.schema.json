          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "host": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "tries_left": {
          "type": "integer"
        },
        "state": {
          "type": "string"
        },
        "retry_after": {
