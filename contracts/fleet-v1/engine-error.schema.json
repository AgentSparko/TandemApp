        },
        "need_gb": {
          "type": "number"
        },
        "backend": {
          "type": "string"
        },
        "engine_api": {
          "type": "string"
        },
        "speaks": {
          "type": "string"
        },
        "plugin": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "fix"
      ],
      "additionalProperties": false
