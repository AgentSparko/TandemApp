{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/engine-models.schema.json",
  "title": "GET /v1/fleet/engines/{id}/models: the engine's Setup Guide models (GET /v1/setup/models: a tile each) and the registry's errors",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "id",
    "models",
    "errors"
  ],
  "additionalProperties": false
}
