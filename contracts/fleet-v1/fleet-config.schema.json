{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/fleet-config.schema.json",
  "title": "GET /v1/fleet/app/export (200, a download): the fleet's configuration as a file (kind tandemapp-fleet-config, version 2; a version 1 file has only version 1's sections): nodes, deployment records, alert rules, saved layouts and app settings, and since version 2 (SRV-847) the hooks, the decision providers, the plugins (name, version, source, sha256, settings, grants), each paired engine host's overlay and the conductor's documents; secrets left out (`excluded` says which), each paired node's pin only as its SHA-256",
  "type": "object",
  "properties": {
    "kind": {
      "const": "tandemapp-fleet-config"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "release": {
      "type": [
        "string",
        "null"
      ]
    },
    "exported_at": {
      "type": "number"
    },
    "from": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "fingerprint",
        "node"
      ],
      "additionalProperties": false
    },
    "secrets": {
      "const": "excluded"
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "colour": {
            "type": "integer"
          },
          "icon": {
            "enum": [
              "desk",
              "cloud",
              "rack"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "class": {
            "type": "string"
          },
          "hw": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "transport": {
            "type": "string"
          },
          "lease_end_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost_per_hour": {
            "type": [
              "number",
              "null"
            ]
          },
          "controller_host": {
            "type": "boolean"
          },
          "paired": {
            "type": "boolean"
          },
          "pin_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "alias",
          "colour",
          "icon",
          "tags",
          "class",
          "hw",
          "address",
          "transport",
          "lease_end_ms",
          "cost_per_hour",
          "controller_host",
          "paired",
          "pin_sha256"
        ],
        "additionalProperties": false
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "serving",
              "stopped"
            ]
          },
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "pack": {
            "type": "string"
          },
          "type": {
            "enum": [
              "single",
              "replicas",
              "split",
              "role"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "engine": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "backend": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "node"
              ],
              "additionalProperties": false
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "options": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "state",
          "name",
          "model",
          "pack",
          "type",
          "members",
          "stages",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "notify": {
            "type": "array",
            "items": {
              "enum": [
                "app",
                "system"
              ]
            }
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "for_s": {
            "type": "number"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "enabled",
          "notify",
          "threshold",
          "for_s",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string"
          },
          "device": {
            "enum": [
              "desk",
              "tablet",
              "phone"
            ]
          },
          "doc": {
            "type": "object"
          }
        },
        "required": [
          "page",
          "device",
          "doc"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object"
    },
    "hooks": {
      "type": "array",
      "description": "every hook: its id, fields and switches; an http hook's secret by name only (`secrets`)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "decision_providers": {
      "type": "array",
      "description": "every decision provider: its id, fields, switches and question mapping; its keys by scope only (`keys`)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "plugins": {
      "type": "array",
      "description": "every installed plugin, never its files: its secrets by name only",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "sha256": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "settings": {
            "type": "object"
          },
          "grants": {
            "type": "object",
            "properties": {
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trust": {
                "type": "string"
              }
            }
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "source",
          "sha256",
          "settings",
          "grants",
          "secrets"
        ]
      }
    },
    "engines": {
      "type": "object",
      "description": "engine host id -> {label, values: the keys its managed overlay sets, secrets: the names of its secret keys that are set}",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "values": {
            "type": "object"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "values"
        ]
      }
    },
    "conductor": {
      "type": "object",
      "description": "the conductor's stored documents: settings key -> document",
      "additionalProperties": {
        "type": "object"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "what could not be read (an engine host that did not answer)"
    }
  },
  "required": [
    "kind",
    "version",
    "release",
    "exported_at",
    "from",
    "secrets",
    "excluded",
    "nodes",
    "deployments",
    "rules",
    "layouts",
    "settings"
  ],
  "additionalProperties": false
}
