        "retry": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "retry",
                "start",
                "rotate_token",
                "upgrade",
                "restart_chatd",
                "re_pair",
                "pick_model",
                "add_engine"
              ]
            },
            "label": {
