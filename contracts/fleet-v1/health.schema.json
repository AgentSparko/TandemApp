{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/health.schema.json",
  "title": "GET /v1/fleet/health[?fresh=1]: the worst state, the first run's setup flag, this controller, every engine host over SSH and the pairing codes the engines refused in the last 10 minutes, each with its findings; actions is every button's label, whether it changes something and whether it needs a confirm",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "checked_at": {
      "type": "number"
    },
    "state": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "error"
      ]
    },
    "setup": {
      "type": "object",
      "properties": {
        "needs_setup": {
          "type": "boolean"
        },
        "engines": {
          "type": "integer"
        },
        "nodes": {
          "type": "integer"
        },
        "backends": {
          "type": "integer"
        },
        "first_page": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "add_engine",
            null
          ]
        }
      },
      "required": [
        "needs_setup",
        "engines",
        "nodes",
        "backends",
        "first_page"
      ],
      "additionalProperties": false
    },
    "controller": {
      "$ref": "health-target.schema.json"
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "health-target.schema.json"
      }
    },
    "pairings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "at": {
            "type": "number"
          },
          "finding": {
            "$ref": "health-finding.schema.json"
          }
        },
        "required": [
          "address",
          "port",
          "at",
          "finding"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "object",
