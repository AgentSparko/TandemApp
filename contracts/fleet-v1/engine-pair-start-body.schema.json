{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/engine-pair-start-body.schema.json",
  "title": "the body of POST /v1/fleet/engines/pair/start: the engine's address (a LAN or tailnet name or address), its HTTP port (8000), the fingerprint the LAN advertised and a name for the node",
  "type": "object",
  "properties": {
    "address": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "fingerprint": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "address"
  ],
  "additionalProperties": false
}
