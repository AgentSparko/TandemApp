{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/import-plan.schema.json",
  "title": "POST /v1/fleet/app/import (200): what an import of the file would do, item by item (add, change, remove, keep, or a conflict with why, skipped), where the file comes from, what of this controller's identity stays, and the confirm (single use, 5 minutes, bound to the file, the mode and the registry as planned)",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "merge",
        "replace"
      ]
    },
    "from": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "exported_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "same_controller": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "fingerprint",
        "exported_at",
        "release",
        "same_controller"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "node",
              "deployment",
              "rule",
              "layout",
              "setting",
              "hook",
              "provider",
              "plugin",
              "engine",
              "conductor"
            ]
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "op": {
            "enum": [
              "add",
              "change",
              "remove",
              "keep",
              "conflict"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "id",
          "label",
          "op",
          "detail",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "add": {
          "type": "integer"
        },
        "change": {
          "type": "integer"
        },
        "remove": {
          "type": "integer"
        },
        "keep": {
          "type": "integer"
        },
        "conflict": {
          "type": "integer"
        }
      },
      "required": [
        "add",
        "change",
        "remove",
        "keep",
        "conflict"
      ],
      "additionalProperties": false
    },
    "allowed": {
      "type": "boolean"
    },
    "blocked": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirm": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "settings": {
      "type": [
        "object",
        "null"
      ],
      "description": "version 2: the change set the import applies through the settings interface (its parts and keys, restart, fingerprint and grant keys); null when it has none",
      "properties": {
        "change_set": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "restart": {
                "type": "string"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "scope",
              "target",
              "keys",
              "restart",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "restart": {
          "type": "string"
        },
        "fingerprint_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grant_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "change_set",
        "changed",
        "parts",
        "restart",
        "fingerprint_keys",
        "grant_keys"
      ],
      "additionalProperties": false
    },
    "stripped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "where the file held a secret by mistake: stripped, never written or answered"
    },
    "fingerprint_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grant_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirm_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "the apply carries it when fingerprint_keys is not empty"
    },
    "confirm_grant": {
      "type": [
        "string",
        "null"
      ],
      "description": "the apply carries it when grant_keys is not empty"
    }
  },
  "required": [
    "contract_version",
    "mode",
    "from",
    "identity",
    "items",
    "counts",
    "allowed",
    "blocked",
    "confirm",
    "expires_at"
  ],
  "additionalProperties": false
}
