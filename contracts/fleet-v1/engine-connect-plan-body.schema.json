{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen38-spark-engine/contract/fleet-v1/engine-connect-plan-body.schema.json",
  "title": "the body of POST /v1/fleet/engines/connect/password/plan: the engine host's SSH address and port (22), the login, the engine's install folder (absolute or ~/..., else ~/TandemLLM) and a name for the node",
  "type": "object",
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "user": {
      "type": "string"
    },
    "engine_dir": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "host",
    "user"
  ],
  "additionalProperties": false
}
