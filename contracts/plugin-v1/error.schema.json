{
 "$id": "plugin-v1/error",
 "description": "every refusal of /v1/fleet/plugins",
 "type": "object",
 "properties": {
  "error": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string"
    },
    "message": {
     "type": "string"
    },
    "field": {
     "type": "string"
    },
    "errors": {
     "type": "array",
     "items": {
      "$ref": "common.schema.json#/$defs/error_item"
     }
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "sha256": {
     "type": [
      "string",
      "null"
     ]
    },
    "installed": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "hooks": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "enabled": {
        "type": "boolean"
       }
      },
      "required": [
       "id",
       "name",
       "enabled"
      ],
      "additionalProperties": false
     }
    },
    "needed": {
     "type": [
      "string",
      "null"
     ]
    },
    "have": {
     "type": [
      "string",
      "null"
     ]
    },
    "fingerprint": {
     "type": "string",
     "description": "fingerprint_confirm_required, fingerprint_mismatch: the key's fingerprint"
    },
    "expect": {
     "type": "string",
     "description": "typed_confirm_required, typed_confirm_mismatch: what to type"
    },
    "level": {
     "type": "string",
     "description": "trust_confirm_needed: the level the new version asks"
    }
   },
   "required": [
    "type",
    "message"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "error"
 ],
 "additionalProperties": false
}
