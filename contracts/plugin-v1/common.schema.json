{
 "$id": "plugin-v1/common",
 "description": "Shapes the answers of /v1/fleet/plugins share.",
 "$defs": {
  "source": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "type": {
       "const": "folder"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "path"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "type": {
       "const": "wheel"
      },
      "path": {
       "type": "string"
      },
      "archive_sha256": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "path",
      "archive_sha256"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "type": {
       "const": "git"
      },
      "url": {
       "type": "string"
      },
      "commit": {
       "type": "string"
      },
      "subdir": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "url",
      "commit"
     ],
     "additionalProperties": false
    }
   ],
   "description": "where the plugin came from, as recorded"
  },
  "signature": {
   "type": "object",
   "properties": {
    "present": {
     "type": "boolean"
    },
    "verified": {
     "type": "boolean"
    },
    "algorithm": {
     "type": [
      "string",
      "null"
     ]
    },
    "key_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "fingerprint": {
     "type": [
      "string",
      "null"
     ],
     "description": "the signing key's fingerprint: the sha256 of its 32 bytes, hex"
    },
    "public_key": {
     "type": [
      "string",
      "null"
     ],
     "description": "the signing key, base64 of 32 bytes"
    },
    "plugin": {
     "type": [
      "string",
      "null"
     ],
     "description": "the plugin the signature names"
    },
    "version": {
     "type": [
      "string",
      "null"
     ],
     "description": "the version the signature names"
    },
    "trusted": {
     "type": [
      "boolean",
      "null"
     ],
     "description": "null without a signature; true when it holds and its key is trusted for this plugin at the level it asks (/v1/fleet/plugin-trust)"
    },
    "key_name": {
     "type": [
      "string",
      "null"
     ],
     "description": "the trusted key's name"
    },
    "error": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "present",
    "verified",
    "algorithm",
    "key_id",
    "fingerprint",
    "public_key",
    "plugin",
    "version",
    "trusted",
    "key_name",
    "error"
   ],
   "additionalProperties": false,
   "description": "plugin.sig.json checked (SEC-18): whether it holds for this tree and manifest, which key signed it, and whether that key is trusted here for this plugin at its level"
  },
  "error_item": {
   "type": "object",
   "properties": {
    "code": {
     "type": "string"
    },
    "field": {
     "type": [
      "string",
      "null"
     ]
    },
    "message": {
     "type": "string"
    },
    "tool": {
     "type": "string"
    },
    "annotation": {
     "type": "string"
    },
    "stage": {
     "type": "string"
    },
    "capability": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "needed": {
     "type": "string"
    },
    "have": {
     "type": "string"
    }
   },
   "required": [
    "code",
    "field",
    "message"
   ],
   "additionalProperties": false,
   "description": "one refusal of a check: `code` (README THE CHECKS), the manifest field it is about, a sentence and its facts"
  },
  "compat": {
   "type": "object",
   "properties": {
    "tandemapp": {
     "type": "string"
    },
    "hooks_api": {
     "type": "string"
    },
    "plugin_api": {
     "type": "string"
    }
   },
   "required": [
    "tandemapp",
    "hooks_api",
    "plugin_api"
   ],
   "additionalProperties": false,
   "description": "the versions this controller checks against"
  },
  "capabilities": {
   "type": "object",
   "properties": {
    "requested": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "granted": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "grants": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "by": {
        "type": [
         "string",
         "null"
        ]
       },
       "at": {
        "type": "integer"
       },
       "confirmed_by": {
        "type": [
         "string",
         "null"
        ]
       },
       "confirmed_at": {
        "type": [
         "integer",
         "null"
        ]
       }
      },
      "required": [
       "by",
       "at",
       "confirmed_by",
       "confirmed_at"
      ],
      "additionalProperties": false
     }
    },
    "confirm": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "the requested capabilities whose grant takes the second confirm (prompts:full, engine:control, a network host outside the LAN), as inspect lists them (SRV-857)"
    }
   },
   "required": [
    "requested",
    "granted",
    "grants"
   ],
   "additionalProperties": false
  },
  "plugin": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "plugin",
      "engine-stats"
     ]
    },
    "title": {
     "type": [
      "string",
      "null"
     ]
    },
    "description": {
     "type": [
      "string",
      "null"
     ]
    },
    "source": {
     "$ref": "common.schema.json#/$defs/source"
    },
    "sha256": {
     "type": "string"
    },
    "signature": {
     "anyOf": [
      {
       "$ref": "common.schema.json#/$defs/signature"
      },
      {
       "type": "null"
      }
     ]
    },
    "enabled": {
     "type": "boolean"
    },
    "trust": {
     "type": "object",
     "properties": {
      "requested": {
       "enum": [
        "sandboxed",
        "host",
        "engine"
       ]
      },
      "granted": {
       "enum": [
        "sandboxed",
        "host",
        "engine"
       ]
      }
     },
     "required": [
      "requested",
      "granted"
     ],
     "additionalProperties": false
    },
    "integrity": {
     "enum": [
      "ok",
      "mismatch",
      "missing"
     ]
    },
    "checked_at": {
     "type": [
      "integer",
      "null"
     ]
    },
    "capabilities": {
     "$ref": "common.schema.json#/$defs/capabilities"
    },
    "contributes": {
     "type": "object",
     "properties": {
      "hooks": {
       "type": "integer"
      },
      "tools": {
       "type": "integer"
      },
      "decision_providers": {
       "type": "integer"
      },
      "backends": {
       "type": "integer"
      },
      "panels": {
       "type": "integer"
      },
      "skills": {
       "type": "integer"
      },
      "engine_hooks": {
       "type": "integer"
      }
     },
     "additionalProperties": false,
     "description": "how many of each the manifest contributes"
    },
    "installed_at": {
     "type": "integer"
    },
    "installed_by": {
     "type": [
      "string",
      "null"
     ]
    },
    "updated_at": {
     "type": "integer"
    },
    "updated_by": {
     "type": [
      "string",
      "null"
     ]
    },
    "row_version": {
     "type": "integer"
    },
    "run": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "properties": {
        "state": {
         "type": "string"
        },
        "held": {
         "type": "boolean"
        },
        "restarts": {
         "type": "integer"
        },
        "failures_last_hour": {
         "type": "integer"
        },
        "next_start_at": {
         "type": [
          "integer",
          "null"
         ]
        },
        "started_at": {
         "type": [
          "integer",
          "null"
         ]
        },
        "last_error": {
         "type": [
          "string",
          "null"
         ]
        },
        "gave_up": {
         "anyOf": [
          {
           "type": "null"
          },
          {
           "$ref": "common.schema.json#/$defs/gave_up"
          }
         ]
        }
       },
       "required": [
        "state",
        "held",
        "restarts",
        "failures_last_hour",
        "next_start_at",
        "started_at",
        "last_error",
        "gave_up"
       ],
       "additionalProperties": false
      }
     ],
     "description": "GET /v1/fleet/plugins only: its process as the plugin host has it (status.schema.json's state and figures, without its registrations); null where no host runs"
    }
   },
   "required": [
    "id",
    "name",
    "version",
    "kind",
    "title",
    "description",
    "source",
    "sha256",
    "signature",
    "enabled",
    "trust",
    "integrity",
    "checked_at",
    "capabilities",
    "contributes",
    "installed_at",
    "installed_by",
    "updated_at",
    "updated_by",
    "row_version"
   ],
   "additionalProperties": false,
   "description": "a plugin in the list"
  },
  "plugin_full": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "plugin",
      "engine-stats"
     ]
    },
    "title": {
     "type": [
      "string",
      "null"
     ]
    },
    "description": {
     "type": [
      "string",
      "null"
     ]
    },
    "source": {
     "$ref": "common.schema.json#/$defs/source"
    },
    "sha256": {
     "type": "string"
    },
    "signature": {
     "anyOf": [
      {
       "$ref": "common.schema.json#/$defs/signature"
      },
      {
       "type": "null"
      }
     ]
    },
    "enabled": {
     "type": "boolean"
    },
    "trust": {
     "type": "object",
     "properties": {
      "requested": {
       "enum": [
        "sandboxed",
        "host",
        "engine"
       ]
      },
      "granted": {
       "enum": [
        "sandboxed",
        "host",
        "engine"
       ]
      }
     },
     "required": [
      "requested",
      "granted"
     ],
     "additionalProperties": false
    },
    "integrity": {
     "enum": [
      "ok",
      "mismatch",
      "missing"
     ]
    },
    "checked_at": {
     "type": [
      "integer",
      "null"
     ]
    },
    "capabilities": {
     "$ref": "common.schema.json#/$defs/capabilities"
    },
    "contributes": {
     "type": "object",
     "properties": {
      "hooks": {
       "type": "integer"
      },
      "tools": {
       "type": "integer"
      },
      "decision_providers": {
       "type": "integer"
      },
      "backends": {
       "type": "integer"
      },
      "panels": {
       "type": "integer"
      },
      "skills": {
       "type": "integer"
      },
      "engine_hooks": {
       "type": "integer"
      }
     },
     "additionalProperties": false,
     "description": "how many of each the manifest contributes"
    },
    "installed_at": {
     "type": "integer"
    },
    "installed_by": {
     "type": [
      "string",
      "null"
     ]
    },
    "updated_at": {
     "type": "integer"
    },
    "updated_by": {
     "type": [
      "string",
      "null"
     ]
    },
    "row_version": {
     "type": "integer"
    },
    "manifest": {
     "type": "object"
    },
    "settings_form": {
     "anyOf": [
      {
       "$ref": "form.schema.json"
      },
      {
       "type": "null"
      }
     ]
    },
    "settings": {
     "type": "object",
     "description": "the settings as they hold: the set values over the schema's defaults"
    },
    "secrets": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "set": {
        "type": "boolean"
       },
       "last4": {
        "type": [
         "string",
         "null"
        ]
       },
       "sha256_6": {
        "type": [
         "string",
         "null"
        ]
       },
       "set_at": {
        "type": [
         "integer",
         "null"
        ]
       }
      },
      "required": [
       "set",
       "last4",
       "sha256_6",
       "set_at"
      ],
      "additionalProperties": false
     },
     "description": "each declared secret: set or unset with its hint, never a value"
    },
    "references": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "enabled": {
        "type": "boolean"
       }
      },
      "required": [
       "id",
       "name",
       "enabled"
      ],
      "additionalProperties": false
     }
    },
    "path": {
     "type": "string"
    },
    "manifest_dir": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "name",
    "version",
    "kind",
    "title",
    "description",
    "source",
    "sha256",
    "signature",
    "enabled",
    "trust",
    "integrity",
    "checked_at",
    "capabilities",
    "contributes",
    "installed_at",
    "installed_by",
    "updated_at",
    "updated_by",
    "row_version",
    "manifest",
    "settings_form",
    "settings",
    "secrets",
    "references",
    "path",
    "manifest_dir"
   ],
   "additionalProperties": false,
   "description": "one plugin with its manifest, settings' form, settings, secrets (hints) and the hooks that name it"
  },
  "trust_grant": {
   "type": "object",
   "properties": {
    "level": {
     "const": "host"
    },
    "basis": {
     "enum": [
      "signature",
      "typed"
     ]
    },
    "key_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "by": {
     "type": [
      "string",
      "null"
     ]
    },
    "at": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "required": [
    "level",
    "basis",
    "key_id",
    "by",
    "at"
   ],
   "additionalProperties": false
  },
  "engine_grant": {
   "type": "object",
   "properties": {
    "basis": {
     "const": "signature+typed"
    },
    "key_id": {
     "type": "string"
    },
    "by": {
     "type": [
      "string",
      "null"
     ]
    },
    "at": {
     "type": "integer"
    }
   },
   "required": [
    "basis",
    "key_id",
    "by",
    "at"
   ],
   "additionalProperties": false
  },
  "trust_policy": {
   "type": "object",
   "properties": {
    "require_signature_sandboxed": {
     "type": "boolean"
    }
   },
   "required": [
    "require_signature_sandboxed"
   ],
   "additionalProperties": false
  },
  "trusted_key": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[0-9a-f]{16}$"
    },
    "fingerprint": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "public_key": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "plugins": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     }
    },
    "levels": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "enum": [
       "sandboxed",
       "host",
       "engine"
      ]
     }
    },
    "added_at": {
     "type": "integer"
    },
    "added_by": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "id",
    "fingerprint",
    "public_key",
    "name",
    "plugins",
    "levels",
    "added_at",
    "added_by"
   ],
   "additionalProperties": false
  },
  "trust": {
   "type": "object",
   "description": "a plugin's trust (SEC-18)",
   "properties": {
    "id": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "requested": {
     "enum": [
      "sandboxed",
      "host",
      "engine"
     ]
    },
    "granted": {
     "enum": [
      "sandboxed",
      "host"
     ]
    },
    "grant": {
     "anyOf": [
      {
       "$ref": "common.schema.json#/$defs/trust_grant"
      },
      {
       "type": "null"
      }
     ]
    },
    "engines": {
     "type": "object",
     "additionalProperties": {
      "$ref": "common.schema.json#/$defs/engine_grant"
     },
     "description": "engine host -> its grant"
    },
    "signature": {
     "$ref": "common.schema.json#/$defs/signature"
    },
    "signed": {
     "type": "string",
     "description": "the signature in words: not signed, signed by whom, why not trusted"
    },
    "trusted_for": {
     "type": "array",
     "items": {
      "enum": [
       "sandboxed",
       "host",
       "engine"
      ]
     },
     "description": "the levels its signature is trusted at"
    },
    "grant_needs": {
     "enum": [
      "none",
      "rights",
      "typed",
      "signature"
     ],
     "description": "what a grant at the requested level takes: none (sandboxed), rights (pairing's: a trusted signature), typed (its id typed), signature (engine: a trusted signature first)"
    },
    "runs": {
     "type": "boolean",
     "description": "whether its trust lets it run now"
    },
    "why": {
     "type": [
      "string",
      "null"
     ],
     "description": "why not"
    },
    "policy": {
     "$ref": "common.schema.json#/$defs/trust_policy"
    }
   },
   "required": [
    "id",
    "version",
    "requested",
    "granted",
    "grant",
    "engines",
    "signature",
    "signed",
    "trusted_for",
    "grant_needs",
    "runs",
    "why",
    "policy"
   ],
   "additionalProperties": false
  },
  "gave_up": {
   "type": "object",
   "description": "the host stopped starting it: when (milliseconds since the epoch, as every other time here), its last error, the failures within the hour, the row version and plugin version it gave up at",
   "properties": {
    "at": {
     "type": "integer"
    },
    "error": {
     "type": [
      "string",
      "null"
     ]
    },
    "failures": {
     "type": "integer"
    },
    "row_version": {
     "type": "integer"
    },
    "version": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "at",
    "error",
    "failures",
    "row_version",
    "version"
   ],
   "additionalProperties": false
  }
 }
}
