{
 "$id": "plugin-v1/install",
 "description": "POST /v1/fleet/plugins: 201 installed, 200 upgraded or unchanged",
 "type": "object",
 "properties": {
  "contract_version": {
   "const": "1.0"
  },
  "plugin": {
   "$ref": "common.schema.json#/$defs/plugin_full"
  },
  "action": {
   "enum": [
    "installed",
    "upgraded",
    "unchanged"
   ]
  },
  "from": {
   "type": "string"
  },
  "kept": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "dropped": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "new": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "what the upgrade asks anew (capabilities.<cap>, ungranted) or got by its typed confirmation (trust)"
  }
 },
 "required": [
  "contract_version",
  "plugin",
  "action",
  "kept",
  "dropped",
  "new",
  "warnings"
 ],
 "additionalProperties": false
}
