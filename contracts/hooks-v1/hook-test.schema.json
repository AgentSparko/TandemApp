{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/fleet/hooks/{id}/test",
  "description": "the hook once against the stage's sample event (examples/), or the body's `event` merged over it; nothing counted or applied; `event` is the event the hook was sent, at its payload level (null when none was sent: the redaction failed).",
  "type": "object",
  "properties": {
    "hook": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "request.received",
        "route.select",
        "request.before_engine",
        "decision.ask",
        "stream.chunk",
        "tool_call.detected",
        "tool.before_exec",
        "tool.after_exec",
        "response.after_engine",
        "request.error",
        "request.finished",
        "memory.write",
        "session.start",
        "session.compact",
        "engine.lifecycle"
      ]
    },
    "outcome": {
      "enum": [
        "ok",
        "timeout",
        "error",
        "invalid",
        "cap",
        "breaker_open",
        "redaction_failed",
        "refused",
        "dropped"
      ]
    },
    "duration_ms": {
      "type": "number"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "diff": {
      "type": "object"
    },
    "event": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "hook",
    "stage",
    "outcome",
    "duration_ms",
    "result",
    "error",
    "event"
  ],
  "additionalProperties": false
}
