{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hooks-v1 event: tool.after_exec",
  "description": "chatd, after a tool ran. The call's `event` at this stage.",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string"
    },
    "call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "result_bytes": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "number"
    },
    "content": {
      "description": "the tool's result (payload redacted or full only; redacted: every string through the redaction)"
    }
  },
  "required": [
    "tool",
    "call_id",
    "ok",
    "result_bytes",
    "duration_ms"
  ],
  "additionalProperties": false
}
