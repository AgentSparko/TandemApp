# TandemApp (the dashboard and proxy) from an env file: copy to app.env, fill in, and start with
#
#   tandem-app serve --env-file app.env                       (pip install ./app)
#   docker run --env-file app.env -p 127.0.0.1:8080:8080 -v tandem-app:/data tandemllm-app
#
# One KEY=VALUE a line, no quotes (docker passes quotes through as part of the value), no spaces
# around `=`. A variable set here wins over the GUI for that field: the Backends screen shows it
# locked with the variable's name. Keys from this file stay in memory and are never written to the
# config database. Keep this file mode 0600 and out of version control. Full list: docs/proxy.md.

# --- the server -----------------------------------------------------------------------------
# where it listens (the image sets 0.0.0.0 and 8080; publish the port to 127.0.0.1 or a LAN address)
#TANDEM_HOST=127.0.0.1
#TANDEM_PORT=8080
# the config database and the usage ledger (the image keeps both in /data)
#TANDEM_CONFIG_DB=~/.tandemllm/config.sqlite3
#TANDEM_USAGE_LEDGER=~/.tandemllm/ledger.sqlite3
# the admin password: unset (the default), every route is open and the dashboard asks for nothing,
# so keep the port on a trusted network; set (32 random characters or more), writes need it
#TANDEM_ADMIN_TOKEN=
#TANDEM_DASHBOARD_LOGIN=off
# the new sign-in (accounts, sessions, a setup code for the first owner): accounts; unset keeps
# the admin password rule above. With it, TANDEM_LOCAL_MODE=off stops trusting this machine's
# browser without a password (the installer writes it for --listen beyond loopback and
# --behind-proxy), and TANDEM_SETUP_CODE_FILE names a file that holds the first setup code.
# Accounts and API tokens are not variables: `tandem-app users` and `tandem-app tokens`, or the
# page. With accounts on, TANDEM_ADMIN_TOKEN, TANDEM_DASHBOARD_LOGIN, TANDEM_API_KEYS and
# TANDEM_API_USERS_FROM are read once, imported, and then only named on the health page: remove
# them once you will not go back to an older release
#TANDEM_AUTH=accounts
#TANDEM_LOCAL_MODE=off
#TANDEM_SETUP_CODE_FILE=
# a proxy on another address that ends TLS: its exact addresses, comma separated (its
# X-Forwarded-Proto and X-Real-IP count only from these)
#TANDEM_TRUSTED_PROXY=
# the master key for keys at rest: base64 of 32 bytes (`openssl rand -base64 32`); without it the
# keychain, then a key file beside the config database
#TANDEM_SECRETS_KEY=

# --- backends -------------------------------------------------------------------------------
TANDEM_BACKENDS=deepseek,vllm1

# a cloud API: its kind fills the URL in
TANDEM_BACKEND_DEEPSEEK_KIND=deepseek
TANDEM_BACKEND_DEEPSEEK_KEY=sk-replace-me
#TANDEM_BACKEND_DEEPSEEK_LABEL=DeepSeek

# any OpenAI-compatible server (vLLM, SGLang, llama.cpp, LM Studio, Ollama, another TandemLLM)
TANDEM_BACKEND_VLLM1_KIND=generic
TANDEM_BACKEND_VLLM1_URL=http://gpu-box:8000/v1
#TANDEM_BACKEND_VLLM1_FALLBACK=deepseek
# requests at once: none (the default) is no limit from the proxy; a number caps it
#TANDEM_BACKEND_VLLM1_MAX_INFLIGHT=none
#TANDEM_BACKEND_VLLM1_TIMEOUT_FIRST_BYTE=600
# where the System view reads that machine: auto (this machine when the URL is), same, collector,
# exporter, off. A collector is `tandem-app hostcollect --host 0.0.0.0` on gpu-box
#TANDEM_BACKEND_VLLM1_HOST=collector
#TANDEM_BACKEND_VLLM1_HOST_URL=http://gpu-box:9108
# or the node_exporter and DCGM exporter pages already running there (no per-process figures)
#TANDEM_BACKEND_VLLM1_HOST=exporter
#TANDEM_BACKEND_VLLM1_HOST_URL=http://gpu-box:9100/metrics
#TANDEM_BACKEND_VLLM1_HOST_DCGM_URL=http://gpu-box:9400/metrics
# the remote collectors' bearer token, the same value on both sides
#TANDEM_COLLECTOR_TOKEN=

# --- routing, prices, users -----------------------------------------------------------------
# ordered rules: a model id that matches the glob goes to the backend
#TANDEM_ROUTE_1=deepseek-*=deepseek
# USD per million tokens: input, cached input, output[, cache write]
#TANDEM_PRICE_1=deepseek/deepseek-flash=0.30,0.006,1.2
#TANDEM_PRICE_1_OFFPEAK=0.15,0.003,0.6
# the proxy's own keys for clients, label:key (from the first one on, a request needs a key).
# With TANDEM_AUTH=accounts: API tokens replace them (`tandem-app tokens create`)
#TANDEM_API_KEYS=laptop:tdm-replace-with-32-random-characters
# SRV-733, a controller in front of an engine: the keys the engine's users hold count here too (read
# from the engine's config database, never copied), and a model id no backend lists goes to the engine
#TANDEM_API_USERS_FROM=~/.qwen38-spark-engine/backends/config.sqlite3
#TANDEM_DEFAULT_BACKEND=engine

# --- Add Spark and the fleet update: the engine ---------------------------------------------
# TandemApp carries no engine. The engine's install.sh that Add Spark runs on a new node and the
# fleet update sends to every node; unset, Add Spark's engine step fails and names it, and a node's
# update skips its engine step. The release it installs is the VERSION file beside it, else this
# TandemApp's own release
#TANDEM_ENGINE_INSTALL_SH=/opt/tandemllm/engine/install.sh
# the engine release to install instead: a tag such as v0.16.0
#TANDEM_ENGINE_REF=

# --- a host with no engine (SRV-841: packaging/linux/tandem-app.sh and tandem-app.service) -----
# no TandemNode agent on this machine (the launcher's default); the conductor off (a bare engine)
#TANDEM_NODE_AGENT=off
#TANDEM_CONDUCTOR=off
# who runs chatd: off (nobody: the Chat tab says Chat is off; what packaging/install.sh writes in a
# new app.env), external (TandemNode or an engine's launchers on the engine host; the default when
# unset), or own: this controller starts and watches it here, with <state dir>/chatd.env
# (packaging/linux/chatd.env.example) and this controller's gateway as its engine. Settings, App,
# What runs here switches Chat on and off from the page; once used, that switch wins over this line
# (docs/install.md)
#TANDEM_CHAT=off
#TANDEM_CHAT_ENV=~/.tandemllm/chatd.env
